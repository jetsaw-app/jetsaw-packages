{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetsaw.app/schemas/plugin.schema.json",
  "title": "Jetsaw Connector Plugin Manifest (plugin.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "protocol", "provides", "capabilities", "command"],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "protocol": {
      "type": "string",
      "pattern": "^\\^\\d+$",
      "description": "Supported connector protocol major range (e.g. ^1)."
    },
    "provides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "tracker": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "forge": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "tracker.read",
          "tracker.children",
          "tracker.versions",
          "tracker.release",
          "tracker.history",
          "tracker.account",
          "tracker.comment",
          "tracker.priority",
          "forge.read",
          "forge.review",
          "forge.threads",
          "forge.open",
          "forge.probe",
          "forge.connection"
        ]
      }
    },
    "kinds": {
      "type": "object",
      "description": "Declarations for custom tracker/forge kinds not built into the core."
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Command and arguments executed from the plugin root folder."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "executables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "credentials": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
